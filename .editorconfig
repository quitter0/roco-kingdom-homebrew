root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows resource scripts and shell scripts keep CRLF (see .gitattributes)
[*.{rc,ps1,bat,cmd}]
end_of_line = crlf

# Binary assets: never rewrite
[*.{glb,gltf,png,jpg,jpeg,ico,mp3,wav,ttf,otf,dat}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
